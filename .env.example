# Copy to .env and fill in. Real environment variables override these.
# .env is gitignored — never commit real credentials.

ARBOR_EMAIL=you@example.com
ARBOR_PW=your-password

# Optional. Leave unset to process ALL schools on the account.
# For a subset, list subdomains comma-separated:
# ARBOR_SCHOOL=schoolone.uk.arbor.sc,schooltwo.uk.arbor.sc

# Optional. Directory for per-school cookie jars (default: ~/.cache/arbor)
# ARBOR_COOKIE_DIR=~/.cache/arbor
